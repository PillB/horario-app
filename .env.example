# ─── Client-side (safe to expose to Expo runtime) ────────────────────────────
# Supabase project URL and anon public key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# URL of the secure API proxy (Expo Router API route)
# In development: http://localhost:8081/api/secure-proxy
# In production: your deployed app URL + /api/secure-proxy
EXPO_PUBLIC_SECURE_PROXY_URL=http://localhost:8081/api/secure-proxy

# Optional: external AI forecast API endpoint
EXPO_PUBLIC_FORECAST_API_URL=

# Account and user identifiers (temporary pre-auth placeholders)
# Replace with real values from Supabase Auth once auth is implemented (Phase 4A)
EXPO_PUBLIC_ACCOUNT_ID=demo-account
EXPO_PUBLIC_USER_ID=local-user

# ─── Server-side ONLY (never expose to client) ───────────────────────────────
# Supabase service role key — used only in app/api/secure-proxy/route.ts
# NEVER prefix with EXPO_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
