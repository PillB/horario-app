# ==============================================================================
# Environment Variables — .env.example
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Clerk Authentication
# Leave EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY blank to enable dev-bypass mode.
# Set to your pk_test_* or pk_live_* key to enable full Clerk auth.
# ------------------------------------------------------------------------------
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_FRONTEND_API=https://YOUR-INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=FILL_ME_IN

# ------------------------------------------------------------------------------
# Supabase
# EXPO_PUBLIC_* keys are safe to expose to the client (anon/publishable only).
# SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY — never expose to the client.
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=FILL_ME_IN
SUPABASE_SERVICE_ROLE_KEY=FILL_ME_IN

# ------------------------------------------------------------------------------
# API Endpoints
# EXPO_PUBLIC_SECURE_PROXY_URL: points to the local API route during development.
# EXPO_PUBLIC_FORECAST_API_URL: leave blank to disable AI forecasting feature.
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SECURE_PROXY_URL=http://localhost:8081/api/secure-proxy
# EXPO_PUBLIC_APP_ORIGIN: used to build the CORS allowed-origins allowlist in API routes.
# Set this to your production domain (e.g. https://horario.app) in production env vars.
EXPO_PUBLIC_APP_ORIGIN=http://localhost:8081
EXPO_PUBLIC_FORECAST_API_URL=

# ------------------------------------------------------------------------------
# App environment
# EXPO_PUBLIC_APP_ENV: production | preview | development. Inlined at build time.
# Set to "production" ONLY for production builds: it hides the support
# diagnostics tab and makes /diagnostics redirect home. Unset = non-production.
# ------------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# Demo / Pre-Auth Placeholders
# These are replaced at runtime once a real user session is established.
# ------------------------------------------------------------------------------
EXPO_PUBLIC_ACCOUNT_ID=demo-account
EXPO_PUBLIC_USER_ID=local-user

# ------------------------------------------------------------------------------
# Payments — Stripe (global cards + annual billing)
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are SERVER-ONLY — never expose.
# Price IDs are created in the Stripe dashboard. See docs/manual-setup/SETUP_STRIPE.md
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=FILL_ME_IN
STRIPE_WEBHOOK_SECRET=FILL_ME_IN
STRIPE_STARTER_MONTHLY_PRICE_ID=FILL_ME_IN
STRIPE_STARTER_ANNUAL_PRICE_ID=FILL_ME_IN
STRIPE_GROWTH_MONTHLY_PRICE_ID=FILL_ME_IN
STRIPE_GROWTH_ANNUAL_PRICE_ID=FILL_ME_IN
STRIPE_PRO_MONTHLY_PRICE_ID=FILL_ME_IN
STRIPE_PRO_ANNUAL_PRICE_ID=FILL_ME_IN

# ------------------------------------------------------------------------------
# Payments — Culqi (Peru: Yape + local cards)
# CULQI_PRIVATE_KEY is SERVER-ONLY. See docs/manual-setup/SETUP_CULQI.md
# ------------------------------------------------------------------------------
CULQI_PRIVATE_KEY=FILL_ME_IN
CULQI_PUBLIC_KEY=FILL_ME_IN
CULQI_WEBHOOK_SECRET=FILL_ME_IN

# ------------------------------------------------------------------------------
# Dev / Simulation
# Set EXPO_PUBLIC_DEV_TIER to simulate a paid tier in dev-bypass mode.
# Values: free | starter | growth | pro
# ------------------------------------------------------------------------------
EXPO_PUBLIC_DEV_TIER=free

# ------------------------------------------------------------------------------
# Batch Scripts (server-side tooling only — not used by the app at runtime)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=FILL_ME_IN
