{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend",
      "rules": [
        {
          "id": "@secretlint/secretlint-rule-aws",
          "options": {
            "allows": [
              "/FILL_ME_IN/",
              "/YOUR[_-]KEY[_-]HERE/i",
              "/^xxx+$/",
              "/EXAMPLE/i",
              "/PLACEHOLDER/i",
              "/YOUR-/i"
            ]
          }
        },
        {
          "id": "@secretlint/secretlint-rule-github",
          "options": {
            "allows": [
              "/FILL_ME_IN/",
              "/YOUR[_-]KEY[_-]HERE/i",
              "/^xxx+$/",
              "/EXAMPLE/i",
              "/PLACEHOLDER/i"
            ]
          }
        },
        {
          "id": "@secretlint/secretlint-rule-slack",
          "options": {
            "allows": [
              "/FILL_ME_IN/",
              "/YOUR[_-]KEY[_-]HERE/i",
              "/^xxx+$/",
              "/EXAMPLE/i",
              "/PLACEHOLDER/i"
            ]
          }
        },
        {
          "id": "@secretlint/secretlint-rule-gcp",
          "options": {
            "allows": [
              "/FILL_ME_IN/",
              "/YOUR[_-]KEY[_-]HERE/i",
              "/^xxx+$/",
              "/EXAMPLE/i",
              "/PLACEHOLDER/i"
            ]
          }
        }
      ]
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Anthropic API Key",
            "pattern": "/sk-ant-(?!api-PLACEHOLDER)[a-zA-Z0-9\\-_]{20,}/",
            "allows": [
              "/FILL_ME_IN/",
              "/YOUR[_-]KEY[_-]HERE/i",
              "/^xxx+$/",
              "/EXAMPLE/i",
              "/sk-ant-api-PLACEHOLDER/",
              "/PLACEHOLDER/i"
            ]
          },
          {
            "name": "Supabase Service Role Key",
            "pattern": "/eyJ[a-zA-Z0-9\\-_]{100,}/",
            "allows": [
              "/FILL_ME_IN/",
              "/YOUR[_-]KEY[_-]HERE/i",
              "/^xxx+$/",
              "/EXAMPLE/i",
              "/PLACEHOLDER/i"
            ]
          },
          {
            "name": "Clerk Secret Key (test)",
            "pattern": "/sk_test_(?!FILL)[a-zA-Z0-9]{20,}/",
            "allows": [
              "/FILL_ME_IN/",
              "/YOUR[_-]KEY[_-]HERE/i",
              "/^xxx+$/",
              "/EXAMPLE/i",
              "/PLACEHOLDER/i"
            ]
          },
          {
            "name": "Clerk Secret Key (live)",
            "pattern": "/sk_live_(?!FILL)[a-zA-Z0-9]{20,}/",
            "allows": [
              "/FILL_ME_IN/",
              "/YOUR[_-]KEY[_-]HERE/i",
              "/^xxx+$/",
              "/EXAMPLE/i",
              "/PLACEHOLDER/i"
            ]
          },
          {
            "name": "Generic high-entropy secret assignment",
            "pattern": "/(SUPABASE_SERVICE_ROLE_KEY|CLERK_SECRET_KEY|ANTHROPIC_API_KEY)\\s*=\\s*(?!FILL_ME_IN|YOUR[_-]KEY|xxx|PLACEHOLDER|$)[a-zA-Z0-9\\-_.+/]{32,}/",
            "allows": [
              "/FILL_ME_IN/",
              "/YOUR[_-]KEY[_-]HERE/i",
              "/^xxx+$/",
              "/EXAMPLE/i",
              "/PLACEHOLDER/i"
            ]
          }
        ]
      }
    }
  ],
  "allowMessageIds": [],
  "ignoreFilePathPatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.expo/**",
    "**/web-build/**",
    "**/scripts/*.json",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/*.lock",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/.env.example",
    "**/.env.local.template",
    "**/CHANGELOG.md",
    "**/*.tsbuildinfo"
  ]
}